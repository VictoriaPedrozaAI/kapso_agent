# Copy to .env (gitignored) for LOCAL use only. Never commit real values.
# Runtime secrets used by the Kapso workflow are set in the Kapso project
# (environment variables) and referenced in code as ${ENV:NAME}.

# Referenced by workflows/kordinia-support/workflow.js as ${ENV:WHATSAPP_PHONE_NUMBER_ID}
WHATSAPP_PHONE_NUMBER_ID=

# Referenced by workflows/kordinia-support/workflow.js as ${ENV:TEAM_ALERT_WHATSAPP}
TEAM_ALERT_WHATSAPP=

# Referenced as ${ENV:ZOHO_FLOW_ALERT_WEBHOOK_URL} (Zoho Flow webhook that sends the alert email)
ZOHO_FLOW_ALERT_WEBHOOK_URL=

# Only needed if you run Kapso scripts without `kapso login`
KAPSO_API_BASE_URL=https://api.kapso.ai
KAPSO_API_KEY=

# Production LLM (MiniMax API) - referenced in workflow.js as ${ENV:Minimax}
Minimax=
